# Copy to infomaniak-deploy.env (gitignored) and run:
#   ./scripts/set-infomaniak-secrets.sh
#
# Repo: lbatschelet/wellspace — Infomaniak deploys (wohlopti.ch + test.feelvonroll.ch)
# Same SSH credentials for both sites; target paths are fixed in each workflow file.

SSH_HOST=u58gso.ftp.infomaniak.com
SSH_USERNAME=uid373276
SSH_PASSWORD=replace-me
# Optional: ed25519 private key (whole file) — preferred for GitHub Actions
# SSH_PRIVATE_KEY=
# Optional (default 22)
# SSH_PORT=22

# Only needed if you use a generic deploy workflow with secrets.SSH_TARGET_PATH.
# Site-specific workflows use fixed paths:
#   deploy-wohlopti-infomaniak.yml           → sites/wohlopti.ch/
#   deploy-feelvonroll-test-infomaniak.yml   → sites/test.feelvonroll.ch/
SSH_TARGET_PATH=sites/wohlopti.ch/
